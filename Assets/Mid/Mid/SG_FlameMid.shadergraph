    "m_FunctionName": "FlameRadiance",
    "m_FunctionSource": "",
    "m_FunctionBody": "Glow = float4(Texel.rgb * float3(1.65, 1.50, 1.18), 1.0);\nOpacity = saturate(Texel.a * Visibility);"
}

