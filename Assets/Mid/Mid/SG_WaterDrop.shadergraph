{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ab2fb466aefa53408709836c61325de7",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Water Drop (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -140,
            "y": -140,
            "width": 218.666748046875,
            "height": 118.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "9cf8497367745e02b38c0ad9ebd98a72"
        },
        {
            "m_Id": "1d37906385e450f0bb27b65551a53a48"
        },
        {
            "m_Id": "6df4750794dc552e9dad76a3fc45f347"
        },
        {
            "m_Id": "84ddbb81f546544c81a2b9ac1af2acdb"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "WaterDrop",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 p = (UV - float2(0.5, 0.5)) * 2.0;\nfloat roundness = smoothstep(0.03, 0.60, Age);\nfloat y = p.y / lerp(0.90, 0.80, roundness);\nfloat taper = lerp(0.53, 0.32, roundness) * smoothstep(-0.24, 1.0, y);\nfloat x = p.x / (0.57 * (1.0 - taper));\nfloat r = length(float2(x, y));\nfloat aa = max(fwidth(r), 0.012);\nfloat mask = 1.0 - smoothstep(1.0 - aa, 1.0 + aa, r);\nfloat rim = smoothstep(0.53, 0.98, r);\nfloat lens = exp(-6.0 * dot(float2(x - 0.14, y + 0.42), float2(x - 0.14, y + 0.42)));\nfloat2 spec = (float2(x, y) - float2(-0.32, 0.35)) * float2(4.0, 2.1);\nfloat highlight = exp(-dot(spec, spec));\nfloat3 body = lerp(float3(0.065, 0.26, 0.34), float3(0.29, 0.67, 0.76), lens);\nbody = lerp(body, float3(0.51, 0.84, 0.91), rim);\nbody = lerp(body, float3(0.94, 1.0, 1.0), highlight);\nTint = float4(body, 1.0);\nOpacity = mask * saturate(0.38 + 0.39 * rim + 0.56 * highlight + 0.12 * lens);"
}

